+// TimePitch directed reconstruction guard, opt-in and disabled.
+#ifndef TIMEPITCH_DIRECTED_RECONSTRUCTION_HPP
+#define TIMEPITCH_DIRECTED_RECONSTRUCTION_HPP
+#include <string>
+namespace timepitch_directed {
+std::string capabilities();
+class UnavailableDirector {
+ public:
+  std::string prepare(const std::string& payload);
+  std::string queue(const std::string& payload) const;
+  std::string step(int ticks) const;
+  std::string export_evidence() const;
+ private:
+  bool prepare_attempted_ = false;
+};
+}  // namespace timepitch_directed
+#endif
