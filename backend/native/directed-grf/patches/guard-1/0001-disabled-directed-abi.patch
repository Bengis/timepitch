+++ b/src/directed_reconstruction.cpp
@@ -0,0 +1,22 @@
+// TimePitch directed reconstruction guard. No world access or physics.
+#include "directed_reconstruction.hpp"
+namespace timepitch_directed {
+std::string capabilities() {
+  return R"json({"version":"grf-directed-port-1","mode":"native_disabled","executionMode":"disabled","patchRevision":"directed-grf-guard-1","status":"unsupported","physicalTickMs":10,"subTickContact":false,"controls":[],"availableChannels":[],"measured":false,"reasons":["initial_state_provider_unavailable","directed_command_path_unavailable","body_contact_evidence_unavailable"]})json";
+}
+std::string UnavailableDirector::prepare(const std::string&) {
+  if (prepare_attempted_) return R"json({"status":"unsupported","reason":"prepare_already_attempted"})json";
+  prepare_attempted_ = true;
+  return R"json({"status":"unsupported","reason":"initial_state_provider_unavailable"})json";
+}
+std::string UnavailableDirector::queue(const std::string&) const {
+  return R"json({"status":"unsupported","reason":"directed_command_path_unavailable"})json";
+}
+std::string UnavailableDirector::step(int ticks) const {
+  if (ticks < 1 || ticks > 100) return R"json({"status":"unsupported","reason":"invalid_tick_count"})json";
+  return R"json({"status":"unsupported","reason":"directed_capture_not_prepared"})json";
+}
+std::string UnavailableDirector::export_evidence() const {
+  return R"json({"status":"unsupported","reason":"directed_capture_not_prepared","measured":false,"samples":null,"events":null,"contacts":null,"clock":null})json";
+}
+}  // namespace timepitch_directed
