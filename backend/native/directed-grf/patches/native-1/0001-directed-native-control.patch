+// TimePitch directed reconstruction, isolated opt-in fork. No runtime entry point.
+#ifndef TIMEPITCH_DIRECTED_RECONSTRUCTION_HPP
+#define TIMEPITCH_DIRECTED_RECONSTRUCTION_HPP
+#include "gamedefines.hpp"
+#include <string>
+#include <vector>
+class GameEnv;
+class Match;
+namespace timepitch_directed {
+std::string capabilities();
+class Director {
+ public:
+  std::string Prepare(GameEnv&, const std::string&);
+  std::string Queue(const std::string&);
+  std::string Step(int);
+  std::string Export() const;
+  bool Active() const { return prepared_ && !failed_; }
+  bool Capturing() const { return prepared_ && sealed_; }
+  bool Initialized() const { return prepared_; }
+  bool Locked() const { return attempted_; }
+  bool NeedsCommand(Player*) const;
+  bool RequestCommand(Player*, PlayerCommandQueue&);
+  bool AllowsBody(const std::string&, const std::string&) const;
+  void ObserveContact(Player*, const std::string&, const std::string&, int);
+  void AfterTick(Match*);
+  void Discontinuity();
+ private:
+  struct Actor { std::string key, id, phase; Player* player; Vector3 position, velocity; float energy; };
+  struct Command {
+    std::string id, kind, body, raw;
+    Player *actor=nullptr, *receiver=nullptr;
+    Vector3 target;
+    unsigned long tick=0, launch=0;
+    e_FunctionType function=e_FunctionType_Movement;
+    float power=0;
+    bool dispatched=false, observed=false, hasTarget=false;
+  };
+  struct Contact {
+    std::string event, actor, body;
+    unsigned long nativeMs, relativeMs;
+    int function, role;
+    Vector3 ball, velocity, animationTarget;
+  };
+  struct Sample {
+    unsigned long tick, nativeMs;
+    std::vector<Vector3> positions, velocities;
+    Vector3 ball, velocity;
+    int homeGoals, awayGoals;
+  };
+  Actor* Find(Player*);
+  Player* Resolve(const std::string&) const;
+  std::string Fail(const std::string&);
+  void Capture(Match*);
+  GameEnv* game_=nullptr;
+  bool attempted_=false, prepared_=false, sealed_=false, failed_=false;
+  unsigned long epoch_=0, ticks_=0, total_=0;
+  double sourceMs_=0;
+  std::string reason_, profileJson_, initialJson_;
+  std::vector<Actor> actors_;
+  std::vector<Command> commands_;
+  std::vector<Contact> contacts_;
+  std::vector<Sample> samples_;
+};
+} // namespace timepitch_directed
+#endif
