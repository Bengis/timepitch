+  out["profileJson"]=profileJson_;out["initialPacketUtf8"]=initialJson_;out["nativeEpochMs"]=epoch_;out["sourceStartMs"]=sourceMs_;out["physicalTicks"]=ticks_;
+  bp::list actors,commands,contacts,samples;
+  for(const auto& a:actors_){bp::dict d;d["playerKey"]=a.key;d["engineId"]=a.id;actors.append(d);}
+  for(const auto& c:commands_){bp::dict d;d["eventId"]=c.id;d["inputPacketUtf8"]=c.raw;d["dispatched"]=c.dispatched;d["contactObserved"]=c.observed;commands.append(d);}
+  for(const auto& c:contacts_){bp::dict d;d["eventId"]=c.event;d["actorEngineId"]=c.actor;d["nativeMs"]=c.nativeMs;d["relativeMs"]=c.relativeMs;d["bodyPart"]=c.body;d["function"]=c.function;d["role"]=c.role;d["ballNative"]=XYZ(c.ball);d["ballVelocityAfterNative"]=XYZ(c.velocity);d["animationTargetNative"]=XYZ(c.animationTarget);d["animationTargetAuthority"]="animation_target_not_body_surface";d["bodySurface"]=bp::object();contacts.append(d);}
