@@ -0,0 +1,246 @@
+// TimePitch directed native control. Historical constraints never set a score.
+#include "directed_reconstruction.hpp"
+#include "game_env.hpp"
+#include "gametask.hpp"
+#include "onthepitch/match.hpp"
+#include "onthepitch/player/player.hpp"
+#include "onthepitch/player/humanoid/humanoid.hpp"
+#include "onthepitch/AIsupport/AIfunctions.hpp"
+#include <boost/python.hpp>
+#include <algorithm>
+#include <cmath>
+#include <set>
+#include <stdexcept>
+namespace bp = boost::python;
+namespace timepitch_directed {
+namespace {
+void Check(bool ok, const char* code) { if (!ok) throw std::invalid_argument(code); }
+bp::dict Dict(bp::object o) { Check(PyDict_Check(o.ptr()), "object_required"); return bp::extract<bp::dict>(o); }
+std::string Text(bp::object o) { Check(PyUnicode_Check(o.ptr()), "string_required"); return bp::extract<std::string>(o); }
+double Number(bp::object o) {
+  Check(!PyBool_Check(o.ptr()) && (PyLong_Check(o.ptr()) || PyFloat_Check(o.ptr())), "number_required");
+  double n=bp::extract<double>(o); Check(std::isfinite(n), "nonfinite_number"); return n;
+}
+unsigned long Integer(bp::object o, unsigned long max) {
+  double n=Number(o); Check(n>=0 && n<=max && std::floor(n)==n,"bounded_integer_required"); return static_cast<unsigned long>(n);
+}
+bp::dict Pairs(bp::list pairs) {
+  bp::dict out;
+  for(int i=0;i<bp::len(pairs);++i) { bp::object p=pairs[i]; Check(!out.has_key(p[0]),"duplicate_key");out[p[0]]=p[1]; }
+  return out;
+}
+bp::object BadConstant(std::string) { throw std::invalid_argument("nonfinite_json"); }
+void Finite(bp::object value,int depth=0) {
+  Check(depth<=64,"json_depth");
+  if(PyFloat_Check(value.ptr()) || (PyLong_Check(value.ptr()) && !PyBool_Check(value.ptr()))) {Number(value);return;}
+  if(PyDict_Check(value.ptr())) {bp::list values=Dict(value).values();for(int i=0;i<bp::len(values);++i)Finite(values[i],depth+1);}
+  else if(PyList_Check(value.ptr())) {for(int i=0;i<bp::len(value);++i)Finite(value[i],depth+1);}
+}
+bp::dict Parse(const std::string& raw) {
+  Check(raw.size()<=4194304,"packet_limit");
+  bp::dict result=Dict(bp::import("json").attr("loads")(raw,bp::arg("object_pairs_hook")=bp::make_function(&Pairs),bp::arg("parse_constant")=bp::make_function(&BadConstant)));
+  Finite(result);return result;
+}
+std::string Json(bp::object value) { return bp::extract<std::string>(bp::import("json").attr("dumps")(value,bp::arg("allow_nan")=false)); }
+bp::object Value(bp::object prior) { return Dict(prior)["value"]; }
+Vector3 Vector(bp::object obj, bool requiredZ=true) {
+  bp::dict d=Dict(obj);Check(Text(d["space"])=="grf_world_metres","world_basis");
+  Check(!requiredZ || d.has_key("z"),"physical_z_required");
+  if(d.has_key("z")) Check(Text(d["zUnit"])=="metres","physical_z_unit");
+  return Vector3(static_cast<float>(Number(d["x"])),static_cast<float>(Number(d["y"])),static_cast<float>(d.has_key("z")?Number(d["z"]):0));
+}
+Vector3 World(Vector3 v, bool mirrored) { if(mirrored) {v.coords[0]=-v.coords[0];v.coords[1]=-v.coords[1];}return v; }
+bp::dict XYZ(const Vector3& v) { bp::dict d;d["x"]=v.coords[0];d["y"]=v.coords[1];d["z"]=v.coords[2];return d; }
+void Speed(const Vector3& v, double limit) {
+  double x=v.coords[0]*105.0/110.0,y=v.coords[1]*68.0/72.0;
+  Check(std::sqrt(x*x+y*y+v.coords[2]*v.coords[2])<=limit,"initial_speed_limit");
+}
+std::string Unsupported(const char* reason) {
+  // Native callbacks also run under legacy wrappers which release the Python GIL.
+  std::string escaped;const char* hex="0123456789abcdef";
+  for(unsigned char c:std::string(reason)) {
+    if(c=='"' || c=='\\') {escaped.push_back('\\');escaped.push_back(static_cast<char>(c));}
+    else if(c<32 || c>=128) {escaped+="\\u00";escaped.push_back(hex[c>>4]);escaped.push_back(hex[c&15]);}
+    else escaped.push_back(static_cast<char>(c));
+  }
+  return "{\"status\":\"unsupported\",\"reason\":\""+escaped+"\"}";
+}
+}
+std::string capabilities() {
+  return R"json({"version":"grf-directed-native-capabilities-1","patchRevision":"directed-grf-native-1","mode":"native_opt_in_unvalidated","executionMode":"disabled","physicalTickMs":10,"subTickContact":false,"controls":["cold_start","pass","shot","trap","interfere","deflect"],"contactAuthority":"native_touch_callback_not_body_certificate","initialStatePolicy":"grf-directed-cold-start-1","measured":false})json";
+}
+std::string Director::Fail(const std::string& reason) { failed_=true;if(reason_.empty())reason_=reason;return Unsupported(reason_.c_str()); }
+Director::Actor* Director::Find(Player* p) { for(auto& a:actors_)if(a.player==p)return &a;return nullptr; }
+Player* Director::Resolve(const std::string& id) const { for(const auto& a:actors_)if(a.id==id)return a.player;throw std::invalid_argument("actor_unmapped"); }
+std::string Director::Prepare(GameEnv& game,const std::string& payload) {
+  if(attempted_) return Fail("prepare_already_attempted");
+  attempted_=true;
+  try {
+    Check(game.context && game.context->gameTask && game.state==game_running,"existing_world_required");
+    ContextHolder context(&game);
+    bp::dict p=Parse(payload),initial=Dict(p["initialState"]),options=Dict(p["nativeOptions"]),profile=Dict(p["profile"]),clock=Dict(p["clock"]);
+    Check(Text(options["version"])=="grf-directed-native-options-1" && Text(options["initialStatePolicy"])=="grf-directed-cold-start-1","initial_policy");
+    Check(Text(profile["executionMode"])=="disabled" && Text(profile["transformId"])=="grf-world-110x72-canonical-105x68-v1","profile_basis");
+    unsigned long seed=Integer(p["seed"],4294967295UL);Check(seed==Integer(profile["seed"],4294967295UL),"seed_binding");
+    Check(Integer(initial["period"],1)==1 && Text(Value(initial["phase"]))=="open_play","initial_phase");
+    Check(Value(Dict(initial["ball"])["ownerId"]).is_none(),"initial_retained_owner_unsupported");
+    bp::dict caches=Dict(Value(initial["caches"]));
+    Check(Text(caches["revision"])=="grf-directed-cold-start-1" && bp::len(Dict(caches["values"]))==0,"initial_caches");
+    total_=Integer(clock["totalTicks"],10000);Check(total_>0 && Integer(clock["tickMs"],10)==10,"physical_clock");
+    sourceMs_=Number(clock["startSourceMs"]);Check(sourceMs_>=0 && sourceMs_==Number(initial["sourceMs"]),"source_clock");
+    Match* match=game.context->gameTask->GetMatch();Check(match,"existing_match_required");
+    Check(match->GetActualTime_ms()==0 && game.context->step==-1,"fresh_unstepped_world_required");
+    bp::list native=bp::extract<bp::list>(p["nativePlayers"]),sources=bp::extract<bp::list>(initial["players"]);
+    std::set<Player*> active,seen;std::set<std::string> keys;
+    for(int side=0;side<2;++side) {std::vector<Player*> members;match->GetActiveTeamPlayers(side,members);active.insert(members.begin(),members.end());}
+    Check(bp::len(native)==int(active.size()) && bp::len(native)==bp::len(sources),"complete_active_roster");
+    for(int i=0;i<bp::len(native);++i) {
+      bp::dict a=Dict(native[i]),source=Dict(sources[i]); Actor actor;
+      actor.id=Text(a["engineId"]);actor.key=Text(a["playerKey"]);
+      Check(actor.id==Text(source["engineId"]) && actor.key==Text(source["playerKey"]) && keys.insert(actor.key).second,"source_actor_binding");
+      Check(actor.id.size()>=6 && (actor.id.substr(0,5)=="home:" || actor.id.substr(0,5)=="away:"),"engine_id");
+      std::string tail=actor.id.substr(5);Check(tail.size()<=2 && tail.find_first_not_of("0123456789")==std::string::npos,"engine_slot");
+      int slot=std::stoi(tail),side=actor.id.substr(0,4)=="home"?0:1;
+      const auto& members=match->GetTeam(side)->GetAllPlayers();
+      Check(slot<=10 && slot<int(members.size()) && std::to_string(slot)==tail,"engine_slot");actor.player=members[slot];
+      Check(active.count(actor.player) && seen.insert(actor.player).second && !actor.player->ExternalControllerActive(),"native_actor_active");
+      Check(Text(Dict(source["position"])["provenance"])=="inferred" && bp::len(Dict(Value(source["memory"])))==0,"inferred_cold_root_memory");
+      actor.position=Vector(Value(a["position"]));actor.velocity=Vector(Value(a["velocity"]));actor.phase=Text(Value(source["phase"]));actor.energy=static_cast<float>(Number(Value(source["energy"])));
+      Check(actor.position.coords[0]>=-55 && actor.position.coords[0]<=55 && actor.position.coords[1]>=-36 && actor.position.coords[1]<=36 && actor.position.coords[2]==0 && actor.velocity.coords[2]==0,"ground_initial_state");
+      Check(actor.energy>=0.01f && actor.energy<=1 && (actor.phase=="standing" || actor.phase=="moving"),"initial_energy_phase");
+      Check((actor.phase=="standing")== (actor.velocity.GetLength()==0),"initial_phase_velocity");Speed(actor.velocity,9);actors_.push_back(actor);
+    }
+    bp::dict ball=Dict(p["nativeBall"]);Vector3 ballPos=Vector(Value(ball["position"])),ballVelocity=Vector(Value(ball["velocity"]));
+    Check(ballPos.coords[2]>=0 && Value(ball["ownerId"]).is_none(),"initial_ball");Speed(ballVelocity,45);
+    // All validation precedes initialization. Rejected jobs never continue in this world.
+    game_=&game;profileJson_=Json(profile);initialJson_=payload;randomseed(static_cast<unsigned int>(seed));
+    bool m0=match->GetTeam(0)->isMirrored(),m1=match->GetTeam(1)->isMirrored(),mb=match->isBallMirrored();
+    match->Mirror(m0,m1,mb);
+    try {
+      match->ResetSituation(ballPos);match->SetMatchPhase(e_MatchPhase_1stHalf);match->StopSetPiece();match->StartPlay();
+      auto& buffer=const_cast<RefereeBuffer&>(match->GetReferee()->GetBuffer());buffer.active=false;buffer.endPhase=false;buffer.taker=nullptr;
+      for(int side=0;side<2;++side)match->GetTeam(side)->GetController()->PrepareSetPiece(e_GameMode_Normal,match->GetTeam(1-side),0,-1);
+      for(auto& a:actors_) {a.player->ResetPosition(a.position,a.position+(a.velocity.GetLength()>0?a.velocity:ballPos-a.position));a.player->DirectedEnergy(a.energy);a.player->CastHumanoid()->DirectedInitialise(a.velocity);}
+      match->GetBall()->SetPosition(ballPos);match->GetBall()->SetMomentum(ballVelocity);match->DirectedRebuildMentalImages();
+      for(auto& a:actors_) Check(a.player->CastHumanoid()->DirectedSelectInitial(a.velocity),"initial_animation_unavailable");
+    } catch(...) {match->Mirror(m0,m1,mb);throw;}
+    match->Mirror(m0,m1,mb);
