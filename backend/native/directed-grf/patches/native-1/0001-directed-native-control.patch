+    prepared_=true;Capture(match);
+    return R"json({"status":"ok"})json";
+  } catch(const bp::error_already_set&) {PyErr_Clear();return Fail("invalid_native_initial_json");}
+    catch(const std::exception& e) {return Fail(e.what());}
+}
+std::string Director::Queue(const std::string& payload) {
+  if(!Active() || sealed_)return Fail("queue_not_open");
+  try {
+    bp::dict p=Parse(payload),n=Dict(p["nativeControl"]);Command c;
+    c.id=Text(p["eventId"]);c.kind=Text(p["kind"]);c.raw=payload;c.actor=Resolve(Text(p["actorEngineId"]));
+    if(!bp::object(p["recipientEngineId"]).is_none())c.receiver=Resolve(Text(p["recipientEngineId"]));
+    c.body=bp::object(p["bodyPart"]).is_none()?"":Text(p["bodyPart"]);
+    bp::dict historical=Dict(Dict(p["sourceCommand"])["event"]);
+    Check(Text(historical["id"])==c.id && Text(historical["kind"])==c.kind && Text(historical["actorId"])==Find(c.actor)->key,"historical_actor_binding");
+    Check(Number(historical["elapsedMs"])==Number(p["sourceMs"]) && PyObject_RichCompareBool(bp::object(historical["bodyPart"]).ptr(),bp::object(p["bodyPart"]).ptr(),Py_EQ)==1,"historical_contact_binding");
+    Check(PyObject_RichCompareBool(bp::object(historical["outcome"]).ptr(),bp::object(p["outcomeConstraint"]).ptr(),Py_EQ)==1,"historical_outcome_binding");
+    if(c.receiver)Check(Text(historical["recipientId"])==Find(c.receiver)->key,"historical_receiver_binding");
+    else Check(bp::object(historical["recipientId"]).is_none(),"historical_receiver_binding");
+    Check(c.body.empty() || c.body=="left_foot" || c.body=="right_foot" || c.body=="head","body_constraint");
+    c.tick=Integer(p["physicalTick"],total_);c.launch=Integer(n["launchTick"],total_);
+    Check(c.launch<=c.tick && c.tick<total_ && Number(p["sourceMs"])==sourceMs_+c.tick*10.0,"fixed_grid_contact_boundary");
+    c.power=static_cast<float>(Number(n["power"]));Check(c.power>=0 && c.power<=1,"power_range");std::string function=Text(n["function"]);
+    if(c.kind=="Pass") {
+      Check(c.receiver && c.receiver!=c.actor && c.receiver->GetTeamID()==c.actor->GetTeamID(),"explicit_receiver");
+      Check(function=="short_pass" || function=="long_pass" || function=="high_pass","pass_function");
+      c.function=function=="short_pass"?e_FunctionType_ShortPass:function=="long_pass"?e_FunctionType_LongPass:e_FunctionType_HighPass;
+    } else if(c.kind=="Shot" && function=="shot") c.function=e_FunctionType_Shot;
+    else if((c.kind=="Ball Receipt*" || c.kind=="Ball Recovery") && function=="trap")c.function=e_FunctionType_Trap;
+    else if((c.kind=="Block" || c.kind=="Interception" || c.kind=="Duel") && function=="interfere")c.function=e_FunctionType_Interfere;
+    else if(c.kind=="Goal Keeper" && function=="deflect")c.function=e_FunctionType_Deflect;
+    else throw std::invalid_argument("native_control_unavailable");
+    Check(!bp::object(p["targetNative"]).is_none() || c.receiver || c.function==e_FunctionType_Trap || c.function==e_FunctionType_Interfere || c.function==e_FunctionType_Deflect,"target_required");
+    if(!bp::object(p["targetNative"]).is_none()) {c.target=Vector(p["targetNative"],false);c.hasTarget=true;}
+    Check(commands_.size()<1000,"command_limit");
+    for(const auto& old:commands_) {Check(old.id!=c.id,"event_duplicate");if(old.actor==c.actor)Check(c.launch>old.tick || old.launch>c.tick,"actor_window_overlap");}
+    commands_.push_back(c);return R"json({"status":"ok"})json";
+  } catch(const bp::error_already_set&) {PyErr_Clear();return Fail("invalid_native_command_json");}
+    catch(const std::exception& e) {return Fail(e.what());}
+}
+bool Director::NeedsCommand(Player* actor) const {
+  if(!Active())return false;
+  for(const auto& c:commands_)if(c.actor==actor && !c.dispatched && c.launch<=ticks_ && ticks_<=c.tick)return true;
+  return false;
+}
+bool Director::RequestCommand(Player* actor,PlayerCommandQueue& queue) {
+  if(!Active())return false;
+  for(auto& c:commands_)if(c.actor==actor && !c.observed && c.launch<=ticks_ && ticks_<=c.tick) {
+    PlayerCommand command;command.desiredFunctionType=c.function;command.directedEventId=c.id;
+    command.useDesiredMovement=true;command.desiredDirection=actor->GetDirectionVec();command.desiredVelocityFloat=actor->GetMovement().GetLength();
+    Match* match=game_->context->gameTask->GetMatch();
+    Vector3 nativeBallTarget=World(match->GetBall()->Predict(0),match->isBallMirrored());
+    command.useDesiredLookAt=true;Vector3 target=World(c.hasTarget?c.target:nativeBallTarget,actor->GetTeam()->isMirrored());
+    command.desiredLookAt=c.receiver?c.receiver->GetPosition():target;
+    command.useTouchInfo=true;command.touchInfo.inputDirection=(command.desiredLookAt-actor->GetPosition()).GetNormalized(actor->GetDirectionVec());
+    command.touchInfo.inputPower=c.power;command.touchInfo.desiredPower=c.power;command.touchInfo.desiredDirection=command.touchInfo.inputDirection;
+    command.touchInfo.autoDirectionBias=0;command.touchInfo.autoPowerBias=0;
+    if(c.receiver) {
+      command.touchInfo.forcedTargetPlayer=c.receiver;command.touchInfo.targetPlayer=c.receiver;
+      AI_GetPass(actor,c.function,command.touchInfo.inputDirection,c.power,1,1,command.touchInfo.desiredDirection,command.touchInfo.desiredPower,command.touchInfo.targetPlayer,c.receiver);
+    }
+    queue.clear();queue.push_back(command);c.dispatched=true;return true;
+  }
+  return false;
+}
+bool Director::AllowsBody(const std::string& id,const std::string& actual) const {
+  if(id.empty())return true;
+  for(const auto& c:commands_)if(c.id==id)return c.body.empty() || c.body==actual;
+  return false;
+}
+void Director::ObserveContact(Player* actor,const std::string& id,const std::string& body,int role) {
+  if(!Active())return;
+  if(contacts_.size()>=20000) {Fail("contact_limit");return;}
+  Match* match=game_->context->gameTask->GetMatch();Actor* a=Find(actor);if(!a){Fail("contact_actor_unmapped");return;}
+  Contact contact;contact.event=id;contact.actor=a->id;contact.body=body;contact.role=role;contact.function=int(actor->GetCurrentFunctionType());
+  contact.nativeMs=match->GetActualTime_ms();contact.relativeMs=contact.nativeMs-epoch_;
+  contact.ball=World(match->GetBall()->Predict(0),match->isBallMirrored());contact.velocity=World(match->GetBall()->GetMovement(),match->isBallMirrored());
+  contact.animationTarget=World(actor->CastHumanoid()->DirectedAnimationTarget(),actor->GetTeam()->isMirrored());contacts_.push_back(contact);
+  if(id.empty())return;
+  for(auto& c:commands_)if(c.id==id) {
+    if(c.actor!=actor || c.observed || contact.relativeMs!=c.tick*10 || contact.function!=int(c.function) || (!c.body.empty() && c.body!=body)) {Fail("actual_contact_mismatch");return;}
+    c.observed=true;return;
+  }
+  Fail("unknown_contact_command");
+}
+void Director::Capture(Match* match) {
+  Sample s;s.tick=ticks_;s.nativeMs=match->GetActualTime_ms();s.homeGoals=match->GetScore(0);s.awayGoals=match->GetScore(1);
+  for(const auto& a:actors_) {s.positions.push_back(World(a.player->GetPosition(),a.player->GetTeam()->isMirrored()));s.velocities.push_back(World(a.player->GetMovement(),a.player->GetTeam()->isMirrored()));}
+  s.ball=World(match->GetBall()->Predict(0),match->isBallMirrored());s.velocity=World(match->GetBall()->GetMovement(),match->isBallMirrored());samples_.push_back(s);
+}
+void Director::AfterTick(Match* match) {
+  if(!prepared_ || !sealed_)return;
+  ++ticks_;Capture(match);
+  if(failed_)return;
+  if(ticks_>total_ || match->GetActualTime_ms()!=epoch_+ticks_*10) {Fail("actual_clock_discontinuity");return;}
+  for(const auto& c:commands_)if(!c.observed && c.tick<ticks_) {Fail("contact_not_observed_at_source_tick");return;}
+}
+void Director::Discontinuity() {if(Active())Fail("native_reset_during_capture");}
+std::string Director::Step(int count) {
+  if(!Active())return Unsupported("capture_not_prepared_or_failed");
+  if(count<1 || count>100 || ticks_+count>total_)return Fail("tick_limit");
+  sealed_=true;
+  try {ContextHolder context(game_);for(int i=0;i<count && Active();++i){unsigned long before=ticks_;game_->directed_physical_tick();Check(ticks_==before+1,"native_tick_hook_missing");}
+    if(failed_)return Unsupported(reason_.c_str());return R"json({"status":"ok"})json";
+  }catch(const std::exception& e){return Fail(e.what());}
+}
+std::string Director::Export() const {
